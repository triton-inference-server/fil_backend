From f1bfa8f3e8fbb9ce21bb3a2e353cd02f333e5fad Mon Sep 17 00:00:00 2001
From: Hyunsu Cho <phcho@nvidia.com>
Date: Thu, 8 Oct 2026 15:14:15 -0700
Subject: [PATCH] Use 26.10 RMM

---
 cpp/cmake/thirdparty/get_raft.cmake           |  5 +-
 cpp/cmake/thirdparty/get_rmm.cmake            | 26 ++++++++--
 .../thirdparty/patches/raft_rmm_pin.patch     | 48 +++++++++++++++++++
 3 files changed, 73 insertions(+), 6 deletions(-)
 create mode 100644 cpp/cmake/thirdparty/patches/raft_rmm_pin.patch

diff --git a/cpp/cmake/thirdparty/get_raft.cmake b/cpp/cmake/thirdparty/get_raft.cmake
index 1b0657625..c5fa6aee5 100644
--- a/cpp/cmake/thirdparty/get_raft.cmake
+++ b/cpp/cmake/thirdparty/get_raft.cmake
@@ -37,6 +37,7 @@ function(find_and_configure_raft)
         GIT_REPOSITORY         https://github.com/${PKG_FORK}/raft.git
         GIT_TAG                ${PKG_PINNED_TAG}
         SOURCE_SUBDIR          cpp
+        PATCHES                "./patches/raft_rmm_pin.patch"
         EXCLUDE_FROM_ALL       ${PKG_EXCLUDE_FROM_ALL}
         OPTIONS
           "BUILD_TESTS OFF"
@@ -55,9 +56,9 @@ endfunction()
 # Change pinned tag here to test a commit in CI
 # To use a different RAFT locally, set the CMake variable
 # CPM_raft_SOURCE=/path/to/local/raft
-find_and_configure_raft(VERSION          ${CUML_MIN_VERSION_raft}
+find_and_configure_raft(VERSION          26.10
       FORK             NVIDIA
-      PINNED_TAG       ${rapids-cmake-checkout-tag}
+      PINNED_TAG       v26.10.00
       EXCLUDE_FROM_ALL ${CUML_EXCLUDE_RAFT_FROM_ALL}
       # When PINNED_TAG above doesn't match cuml,
       # force local raft clone in build directory
diff --git a/cpp/cmake/thirdparty/get_rmm.cmake b/cpp/cmake/thirdparty/get_rmm.cmake
index 015136609..8e17fcbcb 100644
--- a/cpp/cmake/thirdparty/get_rmm.cmake
+++ b/cpp/cmake/thirdparty/get_rmm.cmake
@@ -6,9 +6,27 @@
 #=============================================================================

 function(find_and_configure_rmm)
-    include(${rapids-cmake-dir}/cpm/rmm.cmake)
-    rapids_cpm_rmm(BUILD_EXPORT_SET cuml-exports
-                   INSTALL_EXPORT_SET cuml-exports)
+    set(oneValueArgs VERSION FORK PINNED_TAG)
+    cmake_parse_arguments(PKG "${options}" "${oneValueArgs}"
+                          "${multiValueArgs}" ${ARGN} )
+
+    rapids_cpm_find(rmm ${PKG_VERSION}
+      GLOBAL_TARGETS      rmm::rmm rmm::rmm_logger rmm::rmm_logger_impl
+      BUILD_EXPORT_SET    rapids_triton-exports
+      INSTALL_EXPORT_SET  rapids_triton-exports
+        CPM_ARGS
+            GIT_REPOSITORY https://github.com/${PKG_FORK}/rmm.git
+            GIT_TAG        ${PKG_PINNED_TAG}
+            SOURCE_SUBDIR  cpp
+            OPTIONS
+              "BUILD_TESTS OFF"
+              "BUILD_BENCHMARKS OFF"
+    )
+
+    message(VERBOSE "cuML: Using RMM located in ${rmm_SOURCE_DIR}")
 endfunction()

-find_and_configure_rmm()
+find_and_configure_rmm(VERSION    26.10
+                       FORK       rapidsai
+                       PINNED_TAG v26.10.00
+                       )
diff --git a/cpp/cmake/thirdparty/patches/raft_rmm_pin.patch b/cpp/cmake/thirdparty/patches/raft_rmm_pin.patch
new file mode 100644
index 000000000..441d21fae
--- /dev/null
+++ b/cpp/cmake/thirdparty/patches/raft_rmm_pin.patch
@@ -0,0 +1,48 @@
+From 143635a1ce6d4fe779ee385c20a544ff53b7e82b Mon Sep 17 00:00:00 2001
+From: Hyunsu Cho <phcho@nvidia.com>
+Date: Thu, 8 Oct 2026 15:13:20 -0700
+Subject: [PATCH] Use 26.10 RMM
+
+---
+ cpp/cmake/thirdparty/get_rmm.cmake | 26 ++++++++++++++++++++++----
+ 1 file changed, 22 insertions(+), 4 deletions(-)
+
+diff --git a/cpp/cmake/thirdparty/get_rmm.cmake b/cpp/cmake/thirdparty/get_rmm.cmake
+index f1efc7bf..9ecd223f 100644
+--- a/cpp/cmake/thirdparty/get_rmm.cmake
++++ b/cpp/cmake/thirdparty/get_rmm.cmake
+@@ -6,9 +6,27 @@
+ #=============================================================================
+
+ function(find_and_configure_rmm)
+-    include(${rapids-cmake-dir}/cpm/rmm.cmake)
+-    rapids_cpm_rmm(BUILD_EXPORT_SET raft-exports
+-                   INSTALL_EXPORT_SET raft-exports)
++    set(oneValueArgs VERSION FORK PINNED_TAG)
++    cmake_parse_arguments(PKG "${options}" "${oneValueArgs}"
++                          "${multiValueArgs}" ${ARGN} )
++
++    rapids_cpm_find(rmm ${PKG_VERSION}
++      GLOBAL_TARGETS      rmm::rmm rmm::rmm_logger rmm::rmm_logger_impl
++      BUILD_EXPORT_SET    rapids_triton-exports
++      INSTALL_EXPORT_SET  rapids_triton-exports
++        CPM_ARGS
++            GIT_REPOSITORY https://github.com/${PKG_FORK}/rmm.git
++            GIT_TAG        ${PKG_PINNED_TAG}
++            SOURCE_SUBDIR  cpp
++            OPTIONS
++              "BUILD_TESTS OFF"
++              "BUILD_BENCHMARKS OFF"
++    )
++
++  message(VERBOSE "RAFT: Using RMM located in ${rmm_SOURCE_DIR}")
+ endfunction()
+
+-find_and_configure_rmm()
++find_and_configure_rmm(VERSION    26.10
++                       FORK       rapidsai
++                       PINNED_TAG v26.10.00
++                       )
+--
+2.43.0
+
--
2.43.0

